{
  "name": "Noxis",
  "version": "0.1.0",
  "description": "Noxis - mascota de escritorio inteligente y open-source (version Electron)",
  "main": "src/main/main.js",
  "author": "Norvyz",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.norvyz.noxis",
    "productName": "Noxis",
    "win": {
      "target": "portable",
      "icon": "assets/noxis.ico"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "extract-zip": "^2.0.1",
    "tar": "^7.5.22",
    "vosk-browser": "^0.0.8"
  }
}
